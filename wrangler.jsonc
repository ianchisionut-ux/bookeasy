{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookeasy",
  "workers_dev": true,
  "routes": [
    { "pattern": "bookeasy.ro/*", "zone_name": "bookeasy.ro" },
    { "pattern": "www.bookeasy.ro/*", "zone_name": "bookeasy.ro" }
  ],
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/tutorials/*", "/videos/*"]
  },
  "r2_buckets": [
    {
      "binding": "BOOKEASY_FILES",
      "bucket_name": "bookeasy-files",
      "preview_bucket_name": "bookeasy-files-preview"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "ENABLE_CRON_TRIGGERS": "true",
    "CLOUDFLARE_WEB_ANALYTICS_TOKEN": "e8f89610dbac47ba9950572038f70d6c"
  },
  "triggers": {
    "crons": ["0 3-7 * * *", "*/5 * * * *"]
  }
}
