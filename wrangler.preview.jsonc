{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookeasy-preview",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BOOKEASY_FILES",
      "bucket_name": "bookeasy-files-preview"
    }
  ],
  "vars": {
    "BOOKEASY_CLOUDFLARE_PREVIEW": "true",
    "ENABLE_CRON_TRIGGERS": "false"
  }
}
