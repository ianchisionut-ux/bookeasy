# Database (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Preview Worker only: set as a secret on bookeasy-preview, pointing to a separate Neon database.
# Never reuse the production DATABASE_URL. Preview database routes fail closed when this is absent.
# BOOKEASY_PREVIEW_DATABASE_URL="postgresql://preview_user:password@preview_host/preview_db?sslmode=require"

# Set to true only for the explicit npm run migrate:cloudflare command.
# Never set this in automatic Workers Builds or Preview environments.
BOOKEASY_CLOUDFLARE_PRODUCTION_MIGRATION="false"

# App
APP_URL="http://localhost:3000"
TZ="Europe/Bucharest"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Encryption (32-byte key, hex-encoded, for token storage)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Anthropic (bot NLU)
ANTHROPIC_API_KEY=""

# Meta (WhatsApp / Instagram / Facebook)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="alege-un-string-random"
# Configurația WhatsApp Embedded Signup se adaugă când fluxul este activat în Meta
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=""
META_INSTAGRAM_OAUTH_ENABLED="false"

# Google (Business Profile + Google Calendar OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Authorized redirect URI: https://domeniul-tau.ro/api/google-calendar/callback

# Keep public Wallet issuance and check-in disabled until Google has granted publishing access.
GOOGLE_WALLET_PUBLISHING_APPROVED="false"

# Google Maps (hartă publică + geocoding la onboarding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# Files use the BOOKEASY_FILES R2 binding in the Wrangler config.

# Resend (email)
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
ADMIN_NOTIFICATION_EMAIL=""

# Cron protection
CRON_SECRET="alege-un-string-random"

# SMS cloud opțional. Folosește un token secret și un expeditor aprobat în SMSAPI.
BOOKEASY_SMS_PROVIDER=""
SMSAPI_TOKEN=""
SMSAPI_SENDER=""
SMSAPI_DAILY_LIMIT="30"
SMSAPI_AUTO_RECONFIRMATION="false"

# Emitere centralizată a facturilor de abonament în Signal / Next Level
SIGNAL_BILLING_API_URL="https://www.nextlevel-agency.ro/api/integrations/bookeasy/invoices"
SIGNAL_BILLING_API_KEY="aceeasi-cheie-secreta-de-minimum-32-caractere"
